# Copy to .env and fill in. Only `upload` uses these variables.

# Bucket name (required)
CARDLEDGER_S3_BUCKET=
# Endpoint of an S3-compatible service (empty means AWS),
# e.g. https://<account-id>.r2.cloudflarestorage.com for Cloudflare R2
CARDLEDGER_S3_ENDPOINT=

# Credentials: they need only s3:PutObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required (use `auto` for Cloudflare R2)
AWS_DEFAULT_REGION=
