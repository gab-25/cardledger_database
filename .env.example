# Copy to .env and fill in. Only `upload` uses these variables.
# The CLI does not read .env by itself: `docker compose` loads it, and locally use
# `uv run --env-file .env cardledger-db upload`.

# Bucket name (required)
CARDLEDGER_S3_BUCKET=
# OVHcloud Object Storage endpoint for the bucket's region (gra, sbg, rbx, de, uk, waw, bhs, ...)
CARDLEDGER_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net

# S3 credentials of an OVHcloud Public Cloud user: they need only s3:PutObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket's region, the same as in the endpoint
AWS_DEFAULT_REGION=gra
