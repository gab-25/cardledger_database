# Copy to .env and fill in. Only `upload` uses these variables.
# The CLI does not read .env by itself: `docker compose` loads it, and without Docker use
# `uv run --env-file .env cardledger-db upload`.

# Bucket name (required)
CARDLEDGER_S3_BUCKET=
# Endpoint of the S3-compatible service (empty means AWS)
CARDLEDGER_S3_ENDPOINT=

# Credentials: they need only s3:PutObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket's region (required)
AWS_DEFAULT_REGION=
