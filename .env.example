# Copy to .env and fill in. Only `upload` uses these variables.
# `upload` reads .env from the working directory; variables already set in the environment win.

# Bucket name (required)
CARDLEDGER_S3_BUCKET=
# Endpoint of the S3-compatible service (empty means AWS)
CARDLEDGER_S3_ENDPOINT=

# Credentials (required): they need s3:PutObject and s3:ListBucket on the bucket
CARDLEDGER_S3_ACCESS_KEY_ID=
CARDLEDGER_S3_SECRET_ACCESS_KEY=
# The bucket's region (required)
CARDLEDGER_S3_REGION=
